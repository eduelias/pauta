#!/usr/bin/env bash
# Install a Pauta release on du7, switch to it, and roll back if it doesn't come up healthy.
#
#   pauta-deploy X.Y.Z WHEEL LOCKFILE WHEEL_SHA256 LOCK_SHA256
#                                  install release X.Y.Z (absolute paths) and switch to it
#   pauta-deploy --activate X.Y.Z  switch to a release that is already installed
#   pauta-deploy --rollback        switch back to the release before the current one
#   pauta-deploy --status          what is live and what is installed
#   pauta-deploy --capabilities    what this version supports (deploy.yml checks it)
#
# Lives at /usr/local/sbin/pauta-deploy (root:root 0755). The runner user (pauta-runner) may
# run it with sudo and nothing else. The barrier is the runner's job guard: only the owner's
# deploy jobs run as that user, and they pass the sha256s their release build computed. A
# foothold as pauta-runner could still install anything it brings with its own hashes, so
# what this script adds is care with what it is handed:
#   - the wheel and lockfile must match those sha256s (never files from the release page);
#   - they are copied (no links followed) into a private root-owned directory, checked there,
#     and installed from there, so nobody can swap them between the check and the install;
#   - the version is read from the wheel's metadata: nothing from it runs before the switch;
#   - each release's venv belongs to root once installed, so the service can't alter it;
#   - it works from / and runs Python isolated (-I), so files in the caller's directory are
#     never imported.
# See deploy/README.md.
#
# Layout:  /opt/pauta/releases/X.Y.Z/   one venv per release (owned by the service user)
#          /opt/pauta/current           -> the live release (systemd runs current/bin/pauta)
#          /opt/pauta/previous          -> the one before, for --rollback
#          /opt/pauta/deploy.log        one line per deploy, switch and rollback
set -euo pipefail
umask 022

ROOT=/opt/pauta
RELEASES=$ROOT/releases
SERVICE=pauta
SERVICE_USER=pauta
STATE_DIR=/var/lib/pauta
BACKUPS=/var/backups/pauta/pre-deploy
HEALTH=http://127.0.0.1:8088/healthz
KEEP=5            # releases kept on disk (current and previous are never pruned)
PY=(/usr/bin/python3 -I)
VERSION_RE='^[0-9]{1,4}\.[0-9]{1,4}\.[0-9]{1,4}$'
SHA_RE='^[0-9a-f]{64}$'
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PIP_CONFIG_FILE=/dev/null PIP_DISABLE_PIP_VERSION_CHECK=1  # PyPI only, no piwheels

log() { echo "pauta-deploy: $*" >&2; }
die() { log "$*"; exit 1; }
record() {  # deploy.log, and the journal (journalctl -t pauta-deploy); FAILED is an error
    echo "$(date -Is) $*" >> "$ROOT/deploy.log"
    logger -t pauta-deploy -p "user.$([[ $* == FAILED* ]] && echo err || echo notice)" -- "$*" || true
}
as_user() { runuser -u "$SERVICE_USER" -- "$@"; }
version_of() { basename "$(readlink -e "$1" 2>/dev/null || echo none)"; }

health_version() {
    # the version /healthz reports, within ~15 s, or nothing
    local out
    for _ in $(seq 30); do
        if out=$(curl -fsS --max-time 2 "$HEALTH" 2>/dev/null); then
            "${PY[@]}" -c 'import json,sys; d=json.load(sys.stdin); print(d["version"] if d.get("status")=="ok" else "")' <<<"$out"
            return 0
        fi
        sleep 0.5
    done
    return 1
}

switch_to() {  # atomically point `current` at a release dir and restart
    ln -sfn "$1" "$ROOT/current.new"
    mv -T "$ROOT/current.new" "$ROOT/current"
    systemctl restart "$SERVICE"
}

# release dirs are only ever named X.Y.Z (checked in main), so ls is safe below
# shellcheck disable=SC2012
status() {
    echo "live:     $(version_of "$ROOT/current") (healthz: $(health_version || echo down))"
    echo "previous: $(version_of "$ROOT/previous")"
    echo "on disk:  $(ls -1t "$RELEASES" 2>/dev/null | tr '\n' ' ')"
    echo "recent:"
    tail -n 5 "$ROOT/deploy.log" 2>/dev/null | sed 's/^/  /' || true
}

backup_db() {
    # online SQLite backup with the system Python, so it never runs the new release's code
    # (which would migrate the schema before the switch)
    [ -f "$STATE_DIR/pauta.db" ] || return 0
    local out
    out="$BACKUPS/pauta-$(date +%Y%m%d-%H%M%S)-before-$1.db"
    # a copy of everyone's data: pre-deploy backups are for the service user only
    as_user mkdir -p -m 0700 "$BACKUPS"
    as_user "${PY[@]}" -c 'import os,sqlite3,sys
os.umask(0o077)
s, d = sqlite3.connect(sys.argv[1]), sqlite3.connect(sys.argv[2])
s.backup(d); d.close(); s.close()' "$STATE_DIR/pauta.db" "$out"
    as_user find "$BACKUPS" -name 'pauta-*.db' -mtime +90 -delete
    log "database backed up to $out"
}

sha256_of() { sha256sum "$1" | cut -d' ' -f1; }

wheel_version() {  # WHEEL -> the Version in its metadata, if its Name is pauta
    "${PY[@]}" -c 'import sys, zipfile
from email.parser import HeaderParser
with zipfile.ZipFile(sys.argv[1]) as z:
    names = [n for n in z.namelist() if n.count("/") == 1 and n.endswith(".dist-info/METADATA")]
    if len(names) != 1:
        sys.exit("the wheel has no single dist-info/METADATA")
    meta = HeaderParser().parsestr(z.read(names[0]).decode())
name, version = meta["Name"], meta["Version"]
if name != "pauta":
    sys.exit(f"the wheel is {name!r}, not pauta")
print(version)' "$1"
}

copy_in() {  # SRC DEST: copy a regular file without following links (or blocking on a FIFO)
    "${PY[@]}" -c 'import os, shutil, stat, sys
fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
with os.fdopen(fd, "rb") as src:
    if not stat.S_ISREG(os.fstat(src.fileno()).st_mode):
        sys.exit(f"{sys.argv[1]} is not a regular file")
    out = os.open(sys.argv[2], os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(out, "wb") as dst:
        shutil.copyfileobj(src, dst, 1 << 20)' "$1" "$2"
}

stage() {  # VERSION WHEEL LOCK WHEEL_SHA256 LOCK_SHA256 -> a root-owned dir with checked copies
    local version=$1 wheel=$2 lock=$3 dir got
    dir=$(mktemp -d "$ROOT/.incoming.XXXXXX")  # 0700 until the checks pass
    copy_in "$wheel" "$dir/pauta-$version-py3-none-any.whl" || { rm -rf "$dir"; die "can't copy the wheel"; }
    copy_in "$lock" "$dir/requirements.lock" || { rm -rf "$dir"; die "can't copy the lockfile"; }
    got=$(sha256_of "$dir/pauta-$version-py3-none-any.whl")
    [ "$got" = "$4" ] || { rm -rf "$dir"; die "the wheel is not the one the release built (sha256 $got, expected $4)"; }
    got=$(sha256_of "$dir/requirements.lock")
    [ "$got" = "$5" ] || { rm -rf "$dir"; die "requirements.lock is not the one the release built (sha256 $got, expected $5)"; }
    got=$(wheel_version "$dir/pauta-$version-py3-none-any.whl") || { rm -rf "$dir"; die "can't read the wheel's metadata"; }
    [ "$got" = "$version" ] || { rm -rf "$dir"; die "the wheel says version '$got', expected '$version'"; }
    # checked: the service user may now read (and install from) it; only root can change it
    chmod 0755 "$dir"
    chmod 0644 "$dir/pauta-$version-py3-none-any.whl" "$dir/requirements.lock"
    echo "$dir"
}

install_release() {  # VERSION STAGED_DIR -> builds $RELEASES/VERSION unless already complete
    local version=$1 staged=$2 dir=$RELEASES/$1
    if [ -f "$dir/.complete" ]; then
        log "$version is already installed; reusing it"
        return 0
    fi
    rm -rf "$dir"
    install -d -o "$SERVICE_USER" -g "$SERVICE_USER" -m 0755 "$dir"
    as_user "${PY[@]}" -m venv "$dir"
    as_user "$dir/bin/pip" install -q --no-cache-dir --require-hashes --only-binary=:all: \
        -r "$staged/requirements.lock"
    as_user "$dir/bin/pip" install -q --no-cache-dir --no-deps \
        "$staged/pauta-$version-py3-none-any.whl"
    # installed: root's from now on, so the running service can't change this release or the
    # ones kept for a rollback (-h: links themselves, never what they point at)
    chown -R -h root:root "$dir"
    touch "$dir/.complete"
}

# shellcheck disable=SC2012
prune() {
    local keep_cur keep_prev
    keep_cur=$(readlink -e "$ROOT/current" || true)
    keep_prev=$(readlink -e "$ROOT/previous" || true)
    ls -1dt "$RELEASES"/*/ 2>/dev/null | tail -n +$((KEEP + 1)) | while read -r d; do
        d=${d%/}
        [ "$d" = "$keep_cur" ] || [ "$d" = "$keep_prev" ] || { rm -rf "$d"; log "pruned $(basename "$d")"; }
    done
}

activate() {  # VERSION: switch, check health, roll back on failure
    local version=$1 old
    old=$(readlink -e "$ROOT/current" 2>/dev/null || true)
    if [ "$old" = "$RELEASES/$version" ]; then
        systemctl restart "$SERVICE"
    else
        switch_to "$RELEASES/$version"
    fi
    local got
    got=$(health_version || true)
    if [ "$got" = "$version" ]; then
        if [ -n "$old" ] && [ "$old" != "$RELEASES/$version" ]; then
            ln -sfn "$old" "$ROOT/previous"
        fi
        record "live $version (was $(basename "${old:-none}"))"
        log "$version is live"
        return 0
    fi
    log "$version did not come up healthy (healthz: ${got:-no answer}); last log lines:"
    journalctl -u "$SERVICE" -n 30 --no-pager >&2 || true
    if [ -n "$old" ] && [ "$old" != "$RELEASES/$version" ]; then
        switch_to "$old"
        record "FAILED $version, rolled back to $(basename "$old") (healthz: $(health_version || echo down))"
        log "rolled back to $(basename "$old")"
    else
        record "FAILED $version, nothing to roll back to"
    fi
    exit 1
}

main() {
    cd /
    [ "$(id -u)" -eq 0 ] || die "run me as root (sudo)"
    install -d -m 0755 "$ROOT" "$RELEASES"
    exec 9>"$ROOT/.lock"
    flock -w 600 9 || die "another deploy is running"

    case "${1:-}" in
        --capabilities)
            echo "pinned activate"
            ;;
        --status)
            [ $# -eq 1 ] || die "usage: pauta-deploy --status"
            status
            ;;
        --rollback)
            [ $# -eq 1 ] || die "usage: pauta-deploy --rollback"
            local prev
            prev=$(readlink -e "$ROOT/previous" 2>/dev/null) || die "no previous release"
            [ -f "$prev/.complete" ] || die "previous release $prev is not installed"
            backup_db "$(basename "$prev")"
            activate "$(basename "$prev")"
            ;;
        --activate)
            [ $# -eq 2 ] || die "usage: pauta-deploy --activate X.Y.Z"
            [[ $2 =~ $VERSION_RE ]] || die "bad version '$2'"
            [ -f "$RELEASES/$2/.complete" ] ||
                die "$2 is not installed on du7; new versions only come from a release"
            backup_db "$2"
            activate "$2"
            ;;
        *)
            [ $# -eq 5 ] || die "usage: pauta-deploy X.Y.Z WHEEL LOCK WHEEL_SHA256 LOCK_SHA256 | --activate X.Y.Z | --rollback | --status"
            local version=$1 wheel=$2 lock=$3 staged
            [[ $version =~ $VERSION_RE ]] || die "bad version '$version'"
            [[ $4 =~ $SHA_RE && $5 =~ $SHA_RE ]] || die "the sha256s must be 64 lowercase hex digits"
            [[ $wheel == /* && $lock == /* ]] || die "give absolute paths"
            [ "$(basename -- "$wheel")" = "pauta-$version-py3-none-any.whl" ] || die "unexpected wheel '$wheel'"
            [ "$(basename -- "$lock")" = "requirements.lock" ] || die "unexpected lockfile '$lock'"
            [ -f "$wheel" ] && [ ! -L "$wheel" ] || die "no wheel at '$wheel'"
            [ -f "$lock" ] && [ ! -L "$lock" ] || die "no lockfile at '$lock'"
            staged=$(stage "$version" "$wheel" "$lock" "$4" "$5")
            trap 'rm -rf "$staged"' EXIT
            log "installing $version (sha256 $4)"
            install_release "$version" "$staged"
            backup_db "$version"
            activate "$version"
            prune
            ;;
    esac
}

# sourced by the tests (tests/unit/test_deploy_scripts.py), run otherwise
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main "$@"
fi
