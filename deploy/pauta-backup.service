# Nightly backup of the Pauta DB on du7 (started by pauta-backup.timer).
[Unit]
Description=Pauta: nightly pauta.db backup
After=pauta.service

[Service]
Type=oneshot
User=pauta
Group=pauta
Environment=PAUTA_STATE_DIR=/var/lib/pauta
WorkingDirectory=/var/lib/pauta
# 30 days in /var/backups/pauta, plus a second copy on the NAS drive mounted on du7
ExecStart=/opt/pauta/current/bin/pauta backup --dir /var/backups/pauta --keep-days 30 --copy-to /media/nas/backups/pauta

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
# the "-" keeps the backup running when the NAS isn't mounted (the local copy still counts)
ReadWritePaths=/var/lib/pauta /var/backups/pauta -/media/nas/backups/pauta
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
# the DB holds the session-signing secret: copies are for the service user only
UMask=0077
