# Nightly backup of the Pauta DB on du7 (started by pauta-backup.timer), as the service's
# own user.
[Unit]
Description=Pauta: nightly pauta.db backup
After=pauta.service
# then the copy for the NAS, which only the drive's owner can write (pauta-backup-nas.service)
OnSuccess=pauta-backup-nas.service

[Service]
Type=oneshot
User=pauta
Group=pauta
Environment=PAUTA_STATE_DIR=/var/lib/pauta
WorkingDirectory=/var/lib/pauta
# 30 days in /var/backups/pauta
ExecStart=/opt/pauta/current/bin/pauta backup --dir /var/backups/pauta --keep-days 30

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=-/media -/mnt
ReadWritePaths=/var/lib/pauta /var/backups/pauta
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
# a backup is everyone's data: for pauta and its group (the owner, whose NAS copy reads it)
UMask=0027
