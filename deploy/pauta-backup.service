# Nightly backup of the Pauta DB on du7 (started by pauta-backup.timer).
[Unit]
Description=Pauta: nightly pauta.db backup
After=pauta.service
# then the newest copy goes to the NAS (pauta-backup-nas.service: as the NAS's owner, not root)
OnSuccess=pauta-backup-nas.service

[Service]
Type=oneshot
User=pauta
Group=pauta
Environment=PAUTA_STATE_DIR=/var/lib/pauta
WorkingDirectory=/var/lib/pauta
# 30 days in /var/backups/pauta
ExecStart=/opt/pauta/current/bin/pauta backup --dir /var/backups/pauta --keep-days 30

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
ReadWritePaths=/var/lib/pauta /var/backups/pauta
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
ProtectProc=invisible
ProcSubset=pid
SystemCallArchitectures=native
SystemCallFilter=@system-service
# copies are for pauta and its group (the owner, and the NAS copy that runs as the owner)
UMask=0027
