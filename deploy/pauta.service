# Pauta on du7. Installed by hand once (deploy/README.md); releases only move
# /opt/pauta/current (deploy/pauta-deploy), so this file rarely changes.
[Unit]
Description=Pauta (pauta serve) on 127.0.0.1:8088
Documentation=https://github.com/eduelias/pauta
After=network-online.target
Wants=network-online.target

[Service]
# a flood can't take the whole Pi with it
TasksMax=256
MemoryMax=256M
User=pauta
Group=pauta
Environment=PYTHONUNBUFFERED=1
# the DB of record (accounts, passkeys, clients, requests); releases never touch it
Environment=PAUTA_STATE_DIR=/var/lib/pauta
WorkingDirectory=/var/lib/pauta
# passkeys only work on the domain they were made on
Environment=PAUTA_AUTH=passkeys
Environment=PAUTA_RP_ID=pauta.genic.dev
Environment=PAUTA_ORIGIN=https://pauta.genic.dev
# the newest nightly backup's age shows in /metrics (read only)
Environment=PAUTA_BACKUP_DIR=/var/backups/pauta
# loopback only: Caddy (pauta.genic.dev) is the one way in
ExecStart=/opt/pauta/current/bin/pauta serve --host 127.0.0.1 --port 8088
Restart=on-failure
RestartSec=5

# sandbox: its own user, a read-only system, no /home at all (nobody's keys or .env files),
# write access only to its data directory
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
ReadWritePaths=/var/lib/pauta
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# loopback only, both ways: Caddy reaches it on 127.0.0.1 and it needs nothing else (no LAN,
# no internet). Other loopback services are still in reach, so Caddy's admin API must not
# listen on TCP (deploy/README.md)
IPAddressDeny=any
IPAddressAllow=localhost
# other users' processes are invisible, and only the usual system calls are allowed
ProtectProc=invisible
ProcSubset=pid
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
