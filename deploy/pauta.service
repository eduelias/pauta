# Pauta on du7. Installed by hand once (deploy/README.md); releases only move
# /opt/pauta/current (deploy/pauta-deploy), so this file rarely changes.
[Unit]
Description=Pauta (pauta serve) on 127.0.0.1:8088
Documentation=https://github.com/eduelias/pauta
After=network-online.target
Wants=network-online.target

[Service]
# a flood can't take the whole Pi with it
TasksMax=256
MemoryMax=256M
User=esaleh
Group=esaleh
Environment=PYTHONUNBUFFERED=1
# the DB of record (accounts, passkeys, clients, requests); releases never touch it
Environment=PAUTA_STATE_DIR=/home/esaleh/.local/share/pauta
WorkingDirectory=/home/esaleh/.local/share/pauta
# passkeys only work on the domain they were made on (and its subdomains). The app lives on
# app.pauta.cc with passkeys for pauta.cc. During the move from pauta.genic.dev (decision 4)
# both are listed, the new home first; afterwards only pauta.cc and https://app.pauta.cc
Environment=PAUTA_AUTH=passkeys
Environment=PAUTA_RP_ID=pauta.cc,pauta.genic.dev
Environment=PAUTA_ORIGIN=https://app.pauta.cc,https://pauta.genic.dev
# the newest nightly backup's age shows in /metrics (read only: ProtectHome=read-only)
Environment=PAUTA_BACKUP_DIR=/home/esaleh/backups/pauta
# files on requests go to OneDrive (decision 3). A public client id, not a secret: the
# "Pauta" app registration in du7@msn.com's Entra directory. Its token is written next to
# the DB (pauta.db.onedrive-token) when an admin connects on the Equipe page
Environment=PAUTA_ONEDRIVE_CLIENT_ID=a6a25189-1541-430b-ba90-be78b92a8e30
# loopback only: Caddy (app.pauta.cc) is the one way in
ExecStart=/opt/pauta/current/bin/pauta serve --host 127.0.0.1 --port 8088
Restart=on-failure
RestartSec=5

# sandbox: read-only system and home, write access only to the data directory
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/esaleh/.local/share/pauta
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
