# Pauta on du7. Installed by hand once (deploy/README.md); releases only move
# /opt/pauta/current (deploy/pauta-deploy), so this file rarely changes.
[Unit]
Description=Pauta (pauta serve) on 127.0.0.1:8088
Documentation=https://github.com/eduelias/pauta
After=network-online.target
Wants=network-online.target

[Service]
User=esaleh
Group=esaleh
Environment=PYTHONUNBUFFERED=1
# the DB of record (accounts, passkeys, clients, requests); releases never touch it
Environment=PAUTA_STATE_DIR=/home/esaleh/.local/share/pauta
WorkingDirectory=/home/esaleh/.local/share/pauta
# passkeys only work on the domain they were made on
Environment=PAUTA_AUTH=passkeys
Environment=PAUTA_RP_ID=pauta.genic.dev
Environment=PAUTA_ORIGIN=https://pauta.genic.dev
# the newest nightly backup's age shows in /metrics (read only: ProtectHome=read-only)
Environment=PAUTA_BACKUP_DIR=/home/esaleh/backups/pauta
# loopback only: Caddy (pauta.genic.dev) is the one way in
ExecStart=/opt/pauta/current/bin/pauta serve --host 127.0.0.1 --port 8088
Restart=on-failure
RestartSec=5

# sandbox: read-only system and home, write access only to the data directory
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/esaleh/.local/share/pauta
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
