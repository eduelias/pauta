# Pauta's second test copy on du7: https://dev.pauta.cc, demo data only (decision 1), for a
# branch that stays on a real server for a long time while acc.pauta.cc takes the others.
# It runs builds of branches that aren't released or reviewed (decision 9), so it has its
# own user and data dir and no access to /home: production's database is out of its reach.
# pauta-deploy-branch checks User=, ProtectHome= and ExecStart= before every deploy.
# Installed by deploy/provision-branch-env.sh. Settings that aren't the same for every test copy
# (the Meta app, decision 8) go in drop-ins: pauta-dev.service.d/*.conf.
[Unit]
Description=Pauta dev (pauta serve) on 127.0.0.1:8091
Documentation=https://github.com/eduelias/pauta
After=network-online.target
Wants=network-online.target

[Service]
TasksMax=128
MemoryMax=192M
User=pauta-dev
Group=pauta-dev
Environment=PYTHONUNBUFFERED=1
Environment=PAUTA_STATE_DIR=/var/lib/pauta-dev
WorkingDirectory=/var/lib/pauta-dev
StateDirectory=pauta-dev
StateDirectoryMode=0700
Environment=PAUTA_AUTH=passkeys
Environment=PAUTA_RP_ID=dev.pauta.cc
Environment=PAUTA_ORIGIN=https://dev.pauta.cc
# the same public OneDrive app registration as production; this copy connects its own drive
# and keeps its own token (pauta.db.onedrive-token in its state dir)
Environment=PAUTA_ONEDRIVE_CLIENT_ID=a6a25189-1541-430b-ba90-be78b92a8e30
# loopback only: Caddy (dev.pauta.cc) is the one way in
ExecStart=/opt/pauta-dev/current/bin/pauta serve --host 127.0.0.1 --port 8091
Restart=on-failure
RestartSec=5

# sandbox: read-only system, no /home at all, write access only to its state dir
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
