# Appended to /etc/caddy/Caddyfile on du7 (which serves other sites too; its global block
# binds du7's LAN address only and disables the :80 redirect server).
pauta.genic.dev {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	encode gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy 127.0.0.1:8088
}
