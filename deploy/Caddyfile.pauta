# Pauta's sites in the Caddyfile on du7 (~/dns-stack/caddy/Caddyfile, a docker container that
# also serves dom.du7.dev; its global block binds 192.168.2.68 only and disables the :80
# redirect server). DNS for pauta.cc and pauta.team is in du7/dns-zone (OpenTofu), DNS-only
# so these certificates come from TLS-ALPN on 443. That Caddyfile already defines:
#
# (public_site) {
# 	tls {
# 		issuer acme {
# 			disable_http_challenge
# 		}
# 	}
# 	encode gzip
# 	header Strict-Transport-Security "max-age=31536000"
# }
#
# Hosts (decision 4): app.pauta.cc is the app, acc.pauta.cc and dev.pauta.cc test copies
# (decision 9), www.pauta.cc the
# public site; pauta.cc and pauta.team lead to www. Passkeys belong to pauta.cc, so they work
# on app.pauta.cc; production only accepts the origin https://app.pauta.cc.

app.pauta.cc {
	import public_site
	reverse_proxy 127.0.0.1:8088
}

# Acceptance (decision 1): demo data, unreleased builds, the pauta-acc unit, passkeys for
# acc.pauta.cc only.
acc.pauta.cc {
	import public_site
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy 127.0.0.1:8089
}

# The second test copy (decision 9): the same, the pauta-dev unit, passkeys for dev.pauta.cc.
dev.pauta.cc {
	import public_site
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy 127.0.0.1:8091
}

# The public site. Until it exists, a temporary redirect to the app. Fragments survive
# redirects, so an old https://pauta.cc/#/mudar/... link still lands in the app.
www.pauta.cc {
	import public_site
	redir https://app.pauta.cc{uri} 302
}

pauta.cc, pauta.team, www.pauta.team {
	import public_site
	redir https://www.pauta.cc{uri} 301
}

# The old addresses during the move: the same app, so people can still sign in and tap
# "Mudar para app.pauta.cc". Once `pauta users` shows everyone on pauta.cc, replace the
# reverse_proxy with `redir https://app.pauta.cc{uri} 301` and keep that for at least a year.
pauta.genic.dev {
	import public_site
	reverse_proxy 127.0.0.1:8088
}

acc.pauta.genic.dev {
	import public_site
	redir https://acc.pauta.cc{uri} 301
}
