#!/usr/bin/env bash
# The du7 runner's job-started hook: refuse every job except Pauta's deploy.
#
# A self-hosted runner runs whatever a workflow says, for anyone who can make a workflow
# run: a collaborator pushing a branch, or (in a public repo) a pull request from a fork.
# The runner calls this before each job (ACTIONS_RUNNER_HOOK_JOB_STARTED, set in a
# root-owned systemd drop-in); a non-zero exit fails the job before any of its steps run.
#
# Allowed, and nothing else, and only when the owner both started the run and (for a
# re-run) started this attempt:
#   - job `du7` of release.yml, run by pushing a release tag vX.Y.Z (only the owner may)
#   - job `du7` of deploy.yml, run by hand (workflow_dispatch) from main, to switch to a
#     release already installed on du7 (a redeploy or a rollback)
# Release tags and main only change through the rulesets, and workflows only through the
# owner's review (CODEOWNERS), so these two are the owner's own code. Collaborators can
# start and re-run workflows; this is what keeps their runs off du7.
#
# Lives at /usr/local/lib/pauta/runner-job-guard (root:root 0755); see deploy/README.md.
set -u

REPO=eduelias/pauta
OWNER=eduelias
WF=$REPO/.github/workflows

refuse() {
    echo "runner-job-guard: refusing this job on du7: $*" >&2
    logger -t pauta-runner-guard -p user.warning -- "refused: $* (repo=${GITHUB_REPOSITORY:-?} workflow=${GITHUB_WORKFLOW_REF:-?} job=${GITHUB_JOB:-?} event=${GITHUB_EVENT_NAME:-?} actor=${GITHUB_ACTOR:-?} triggered by=${GITHUB_TRIGGERING_ACTOR:-?})" 2>/dev/null || true
    exit 1
}

[ "${GITHUB_REPOSITORY:-}" = "$REPO" ] || refuse "not $REPO"
[ "${GITHUB_JOB:-}" = du7 ] || refuse "only the deploy job (du7) runs here"
[ "${GITHUB_ACTOR:-}" = "$OWNER" ] || refuse "only $OWNER's runs deploy"
[ "${GITHUB_TRIGGERING_ACTOR:-}" = "$OWNER" ] || refuse "only $OWNER may (re-)run a deploy"
ref=${GITHUB_WORKFLOW_REF:-}
event=${GITHUB_EVENT_NAME:-}
tag_re="^$WF/release\.yml@refs/tags/v[0-9]+\.[0-9]+\.[0-9]+$"
if [[ $ref =~ $tag_re ]] && [ "$event" = push ]; then
    :
elif [ "$ref" = "$WF/deploy.yml@refs/heads/main" ] && [ "$event" = workflow_dispatch ]; then
    :
else
    refuse "only release.yml on a release tag, or deploy.yml run by hand on main"
fi
logger -t pauta-runner-guard -p user.notice -- "allowed: $ref ($event, ${GITHUB_ACTOR:-?})" 2>/dev/null || true
echo "runner-job-guard: $ref ($event) may deploy"
